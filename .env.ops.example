# Copy to .env.ops (gitignored, matches the .env.* rule) and fill in.
# Never commit real values -- this is what the pre-publish scrub moved
# out of HEAD. See docs/architecture/cost-controls.md's "Before going
# public" section for why these aren't secrets in the credential sense,
# but are kept out of a public repo anyway.

PROJECT_ID=
PROJECT_NUMBER=
REGION=us-central1
BFF_SERVICE=
FRONTEND_SERVICE=

# source .env.ops before running any runbook command in
# docs/architecture/cost-controls.md or docs/architecture/cicd-setup.md
# that references $PROJECT_ID / $PROJECT_NUMBER / $REGION.
