# Copy to terraform.tfvars (gitignored) and fill in. Never commit real values.

support_email   = "platform-team@meridianhealthplans.com"
csr_group_email = "csr-agents@meridianhealthplans.com"

# VPC network + Cloud SQL private-services peering + Serverless VPC Access
# connector are now provisioned by module "networking" in main.tf -- no
# longer inputs here.

# VPC-SC / Access Context Manager is org-level and unavailable on a
# standalone project (no GCP Organization). Leave both at their defaults
# (enable_vpc_sc = false, access_policy_id unset) unless this project is
# later moved into an org.
# enable_vpc_sc  = true
# access_policy_id = "123456789012"

# Built by cloudbuild/deploy.yaml and pushed to Artifact Registry before
# `terraform apply` runs for this environment.
bff_image      = "us-central1-docker.pkg.dev/csrsupport-dev/csrsupport/bff:latest"
frontend_image = "us-central1-docker.pkg.dev/csrsupport-dev/csrsupport/frontend:latest"

# Left blank on first apply -- IAP audience and Agent Engine resource name
# both depend on resources this same config creates. Set these and re-apply
# once: (1) `terraform output` gives you the IAP backend service ID to
# derive the audience from, and (2) deploy_agent_engine.py has run and
# printed its resource name.
iap_expected_audience     = ""
agent_engine_resource_name = ""

# From the one-time manual "install Cloud Build GitHub App on venkybobby/CSRS"
# + "create a GitHub PAT and store it in Secret Manager" steps -- see
# docs/architecture/cicd-setup.md. Cannot be automated: both require
# interactive GitHub OAuth consent in a browser.
github_app_installation_id = ""
github_pat_secret_id       = "csrsupport-github-pat"

# Database is Supabase Postgres, not Cloud SQL (see
# docs/architecture/cicd-setup.md §4) -- these name the two Secret Manager
# secrets holding least-privilege DATABASE_URL connection strings, created
# manually the same way as github_pat_secret_id above.
migrate_db_url_secret_id      = "csrsupport-migrate-dev-db-url"
agent_engine_db_url_secret_id = "csrsupport-agent-engine-dev-db-url"
