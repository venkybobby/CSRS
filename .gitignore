# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/

# Node / frontend
node_modules/
dist/
.vite/

# Env / secrets
.env
.env.*
!.env.example
*.key.json
*-credentials.json
*service-account*.json

# Cloud SQL local proxy binaries
cloud-sql-proxy
cloud-sql-proxy.exe

# Terraform
**/.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
.terraform.lock.hcl

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Claude Code plugin cache (runtime-generated, not project data)
.claude/data/
*.tsbuildinfo

# Recorded demo takes. Regenerable by scripts/record_demo_video.py and large
# (~5 MB each), and a video is re-recorded per take rather than maintained --
# unlike docs/screenshots/, which is committed precisely because it is the
# record of what a CSR sees and must be diffable.
docs/demo/*.webm
docs/demo/*.mp4
